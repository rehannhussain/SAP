# SAP HANA connection for the ZWFN Finishing (Sanfor) insert backend.
# Copy this file to server/.env and fill in real values. server/.env is gitignored.

HANA_HOST=your-hana-host
HANA_PORT=30015
HANA_USER=YOUR_USER
HANA_PASSWORD=your-password

# true for HANA Cloud / TLS endpoints, false for a plain on-prem port.
HANA_ENCRYPT=true

# How long (ms) to wait for HANA before declaring SAP unavailable. Lower = the
# offline banner shows sooner when SAP is down; too low may false-alarm on a slow
# network. Default 5000 (5s).
HANA_TIMEOUT_MS=5000

# Value written to USERUP fallback if no operator is supplied (normally unused).
APP_USER=ZWFN

# Port the Flask app (UI + API) listens on.
PORT=8000

# Serve over HTTPS. Required for the iPad camera QR scan (Safari blocks the
# camera over plain http:// on a LAN IP). With server/cert.pem + server/key.pem
# present those are used; otherwise a throwaway 'adhoc' cert is generated.
USE_HTTPS=false

# KT SQL Server mirror (SAP_FinishingDetail). On Save the finishing detail is
# also written here (best-effort). Needs the "ODBC Driver 17 for SQL Server".
# Set KT_ENABLED=false to turn the mirror off.
KT_SERVER=your-sqlserver-host
KT_DATABASE=KT
KT_UID=your-sql-user
KT_PWD=your-sql-password
KT_DRIVER=ODBC Driver 17 for SQL Server
KT_ENABLED=false

# SAP RFC - on Save the finished length is transferred 3019 -> 3055 (movement
# type 311) via BAPI_GOODSMVT_CREATE, BEFORE the HANA/SQL save. Needs pyrfc + the
# SAP NW RFC SDK. Set SAP_RFC_MOCK=true to fake the material doc (UI testing), or
# MOVE_311_ENABLED=false to skip the move entirely.
MOVE_311_ENABLED=false
SAP_RFC_MOCK=true
SAP_ASHOST=your-sap-app-server
SAP_SYSNR=00
SAP_CLIENT=900
SAP_USER=your-rfc-user
SAP_PASSWD=your-rfc-password
SAP_LANG=EN
SAP_GM_CODE=04
SAP_MOVE_TYPE=311
SAP_USE_MATERIAL_LONG=true
SAP_HEADER_TXT=ZWFN
# SAPNWRFC_HOME=C:\SAP\nwrfcsdk
